QGroupBox::title { subcontrol-origin: margin; left: 15px; padding: 0 5px; color: #2e7d32; }
QLineEdit, QDoubleSpinBox, QSpinBox { padding: 5px; border: 1px solid #d1d9e6; border-radius: 5px; background-color: #ffffff; }
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus { border: 2px solid #2e7d32; }
