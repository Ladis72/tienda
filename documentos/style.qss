/* 
   GreenLeaf Theme - Inspired by Stitch 
   Primary Green: #7cb342
   Dark Green: #558b2f
   Light Green: #aed581
   Background: #ffffff / #f8f9f8
   Error: #ef5350
*/

QMainWindow, QDialog {
    background-color: #f8f9f8;
}

QWidget {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    color: #2e342e;
}

/* Global Button Style */
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #8bc34a, stop:1 #7cb342);
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #689f38;
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #9ccc65, stop:1 #8bc34a);
}

QPushButton:pressed {
    background-color: #689f38;
}

QPushButton:disabled {
    background-color: #e8f5e9;
    color: #a5d6a7;
    border: 1px solid #c8e6c9;
}

/* Specific button styles */
QPushButton#usuarioButton {
    background-color: #ffffff;
    color: #7cb342;
    border: 2px solid #7cb342;
}

QPushButton#usuarioButton:hover {
    background-color: #f1f8e9;
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: white;
    border: 1px solid #c8e6c9;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #dcedc8;
    selection-color: #1b5e20;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 2px solid #7cb342;
    background-color: #ffffff;
}

/* Tables */
QTableView {
    background-color: white;
    border: 1px solid #e0e0e0;
    gridline-color: #f1f8e9;
    selection-background-color: #dcedc8;
    selection-color: #1b5e20;
    border-radius: 4px;
    outline: 0;
}

QHeaderView::section {
    background-color: #7cb342;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #e0e0e0;
    top: -1px;
    background: white;
    border-radius: 4px;
}

QTabBar::tab {
    background: #f5f5f5;
    color: #757575;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: white;
    color: #7cb342;
    border-bottom: 3px solid #7cb342;
    font-weight: bold;
}

/* Specific Frames */
QFrame#frame_detalles {
    border-left: 2px solid #7cb342;
    background-color: #ffffff;
    border-radius: 0px;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #f1f8e9;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c5e1a5;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #7cb342;
}

/* StatusBar */
QStatusBar {
    background-color: #f1f8e9;
    color: #33691e;
    border-top: 1px solid #dcedc8;
}

QGroupBox {
    border: 2px solid #e8f5e9;
    border-radius: 10px;
    margin-top: 1.5em;
    font-weight: bold;
    color: #388e3c;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 5px;
}

/* LCD Number */
QLCDNumber {
    background-color: #e8f5e9;
    color: #1b5e20;
    border: 1px solid #c8e6c9;
    border-radius: 4px;
}
