QLineEdit:focus { border: 1px solid #2e7d32; }
QPushButton { padding: 8px 15px; border-radius: 4px; font-weight: bold; min-width: 100px; }
QPushButton#pushButtonAceptar, QPushButton#pushButtonGuardar { background-color: #2e7d32; color: white; }
